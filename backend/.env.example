# VisionTrack AI Environment Configuration
APP_NAME="VisionTrack AI"
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Storage Paths
DATABASE_URL="sqlite:///./visiontrack.db"
UPLOAD_DIR="uploads"
OUTPUT_DIR="outputs"
CANDIDATE_DIR="candidate_images"
MODEL_DIR="models"

# ML Settings
DEVICE="auto"  # "auto", "cpu", "mps", "cuda"
YOLO_MODEL="yolo11n.pt"  # or "yolov8n.pt"
CLIP_MODEL="openai/clip-vit-base-patch32"
ENABLE_REID=true
FRAME_SAMPLE_RATE=2  # Process 1 frame every N frames
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.5
DEFAULT_IMAGE_WEIGHT=0.50
DEFAULT_TEXT_WEIGHT=0.50

